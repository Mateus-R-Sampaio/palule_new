rules_version = '2';

// Regras do Storage — logo, mockups, estampas e fontes.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Logos enviadas pelos clientes no checkout (sem login): só imagem, até 10 MB, sem sobrescrever.
    match /customer-logos/{day}/{file} {
      allow read: if true;
      allow create: if request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp|svg\\+xml)');
      allow delete: if isAdmin();
    }

    match /{folder}/{file} {
      allow read: if true;
      allow create, update: if isAdmin()
        && folder in ['mockups', 'arts', 'brand', 'fonts']
        && request.resource.size < 10 * 1024 * 1024;
      allow delete: if isAdmin();
    }
  }
}
