# Copie para functions/.env e preencha. NÃO faça commit do arquivo .env.
# (Para produção, prefira o Secret Manager: firebase functions:secrets:set NOME)

FUNCTIONS_REGION=southamerica-east1
STORE_NAME=Studio Personalizado
STORE_URL=https://seu-projeto.web.app

# ---------- E-mail ----------
# resend | sendgrid | smtp | none
EMAIL_PROVIDER=resend
EMAIL_FROM=Studio Personalizado <pedidos@seudominio.com.br>
EMAIL_REPLY_TO=
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------- Mensagem (WhatsApp / SMS) ----------
# whatsapp_cloud | zapi | evolution | twilio_sms | twilio_whatsapp | none
MESSAGE_PROVIDER=zapi

# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Opcional: template aprovado (obrigatório fora da janela de 24 h). Parâmetros: {{1}} nome, {{2}} código, {{3}} status
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_BR

# Z-API
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=

# Evolution API
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=

# Twilio (SMS ou WhatsApp)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Webhook de pagamento ----------
# Envie o header "x-webhook-secret" com este valor.
PAYMENT_WEBHOOK_SECRET=
