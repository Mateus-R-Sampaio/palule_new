# Copie para server/.env (NUNCA faça commit do .env).

NODE_ENV=production
PORT=3000

# PostgreSQL (Render, Neon, Supabase, RDS, Azure Database for PostgreSQL…)
DATABASE_URL=postgres://usuario:senha@host:5432/studio
DATABASE_SSL=true
# DATABASE_SSL_REJECT_UNAUTHORIZED=false   # só se o provedor usar certificado próprio

# Segredo aleatório (32+ caracteres) — gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SECRET=

# Proxies confiáveis à frente do servidor (Render/Railway/Nginx = 1)
TRUST_PROXY=1

# Outras origens que podem usar a API pública da loja (ex.: GitHub Pages). Separe por vírgula.
ALLOWED_ORIGINS=https://mateus-r-sampaio.github.io

SESSION_HOURS=12
ORDER_RATE_LIMIT=60
STORE_NAME=Studio Personalizado

# ---------- Webhook de pagamento ----------
PAYMENT_WEBHOOK_SECRET=

# ---------- E-mail ----------  resend | sendgrid | smtp | none
EMAIL_PROVIDER=none
EMAIL_FROM=Studio Personalizado <pedidos@seudominio.com.br>
EMAIL_REPLY_TO=
RESEND_API_KEY=
SENDGRID_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ---------- WhatsApp / SMS ----------  whatsapp_cloud | zapi | evolution | twilio_sms | twilio_whatsapp | none
MESSAGE_PROVIDER=none
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=pt_BR
ZAPI_INSTANCE_ID=
ZAPI_TOKEN=
ZAPI_CLIENT_TOKEN=
EVOLUTION_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
